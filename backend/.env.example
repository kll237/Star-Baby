# ============================================================
# StarGuard 星宝守护 · 后端环境变量示例
# 用法：复制本文件为 .env 后，按需修改占位值
#   cp .env.example .env
# 说明：
#   - 所有带 <...> 的字段都需替换为真实值
#   - 含密钥的字段（JWT/AES/短信/LLM/邮件）请使用强随机值
#   - 切勿把真实 .env 提交到代码仓库（已加入 .gitignore）
# ============================================================

# ---------- 基础运行 ----------
# 运行环境：development | production（生产环境会禁用部分调试接口）
NODE_ENV=production
# 监听端口（Docker Compose 内由 nginx 反代，无公网映射需求）
PORT=3000
# 对外可访问的基础地址（用于短信链接、回调、CORS 校验）
# 局域网/自签：https://localhost:3300  或  https://<本机局域网IP>:3300
# 公网部署：https://<你的域名>
APP_BASE_URL=https://localhost:3300
# 单端口部署时由后端托管的前端构建目录（vite build 输出）
# 云部署通常留空，前端由独立 nginx 容器托管
FRONTEND_DIST=../frontend/dist_tmp2

# ---------- 数据库（PostgreSQL） ----------
# 格式：postgresql://<用户>:<密码>@<主机>:<端口>/<库名>?schema=public
DATABASE_URL="postgresql://spchild:<DB_PASSWORD>@postgres:5432/spchild?schema=public"

# ---------- Redis（缓存 / 限流 / 会话 / Socket.IO 适配） ----------
REDIS_HOST=localhost
REDIS_PORT=6379
# 生产环境务必设置强密码（与 docker-compose 中 REDIS_PASSWORD 一致）
REDIS_PASSWORD=<REDIS_PASSWORD>
REDIS_DB=0

# ---------- JWT 鉴权 ----------
# 必改：32 位以上随机字符串，例如 openssl rand -hex 32
JWT_SECRET=<CHANGE_ME_JWT_SECRET_32BYTES_MIN>
# 令牌有效期（access 用于接口，refresh 用于续期）
JWT_ACCESS_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ---------- 数据加密主密钥（AES-256） ----------
# 32 字节十六进制（64 个十六进制字符）。例如：openssl rand -hex 32
# 用于敏感字段落库加密，丢失将无法解密历史数据，请妥善备份
AES_MASTER_KEY=<CHANGE_ME_64HEX_AES_MASTER_KEY>

# ---------- 短信验证码（危机升级 / 登录） ----------
# provider: dev(控制台打印) | aliyun | tencent
SMS_PROVIDER=dev
# 阿里云/腾讯云 AccessKey（dev 模式下可留空）
SMS_ACCESS_KEY=
SMS_ACCESS_SECRET=
# 短信签名与模板（需先在云厂商控制台申请并通过审核）
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=

# ---------- 危机升级邮件渠道 ----------
# 留空则开发环境仅控制台打印，不真实外发；生产建议配置 SMTP
MAIL_HOST=
MAIL_PORT=465
MAIL_USER=
MAIL_PASS=
MAIL_FROM=no-reply@starguard.local

# ---------- 登录防爆破 ----------
# 连续失败次数上限
LOGIN_MAX_FAILS=5
# 达到上限后的锁定秒数
LOGIN_LOCK_SECONDS=900

# ---------- 接口限流（NestJS Throttler） ----------
# 全局默认：TTL 秒内最多 LIMIT 次
THROTTLE_TTL=60
THROTTLE_LIMIT=60
# 鉴权相关（登录/发验证码）更严格：TTL 秒内最多 AUTH_LIMIT 次
THROTTLE_AUTH_TTL=60
THROTTLE_AUTH_LIMIT=10

# ---------- 人脸识别匹配阈值 ----------
# 0~1，越高越严格；建议 0.82~0.88 之间
FACE_MATCH_THRESHOLD=0.85

# ---------- CORS 跨域 ----------
# 开发可填 *；生产务必收紧为前端真实域名
# 公网部署示例：https://<你的域名>
CORS_ORIGIN=*

# ---------- 智能聊天安抚 / LLM ----------
# provider: RULE(内置规则) | MOCK(假数据) | OPENAI(真实调用)
LLM_PROVIDER=RULE
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# 智谱 BigModel（GLM 系列，免费额度友好，适合学生陪伴场景）
# 注册 https://bigmodel.cn/console 后获取；填入后自动作为默认引擎（WebSocket 真实流式）
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-4-flash

# ---------- 语音合成 TTS ----------
# engine: browser(前端浏览器合成，零成本) | server(服务端/第三方)
TTS_ENGINE=browser
# server 模式下的服务地址与密钥（browser 模式可留空）
TTS_ENDPOINT=
TTS_API_KEY=
# 中文语音包名（Microsoft Edge TTS 风格），如 zh-CN-XiaoxiaoNeural
TTS_VOICE=zh-CN-XiaoxiaoNeural

# ---------- 语音识别 ASR ----------
# engine: browser(前端 Web Speech API) | server(需自建/第三方 ASR 服务)
ASR_ENGINE=browser

# ---------- 聊天冷却 ----------
# 同一会话两次 AI 回复的最小间隔（毫秒），防止刷屏/滥用
CHAT_COOLDOWN_MS=300000

# ---------- 桌宠硬件接口（MQTT） ----------
# 留空则使用内置内存 broker（开发/演示单机模式）
# 多实例/真实硬件接入时填远程 broker，如 mqtt://<broker>:1883
MQTT_URL=
MQTT_TOPIC_PREFIX=deskpet

# ---------- HTTPS（仅在后端直接终止 TLS 时需要） ----------
# 云部署建议由前端 nginx 终止 TLS，此处设 false
# 本机自签/单端口 HTTPS 时设 true，并指定证书路径
ENABLE_HTTPS=false
HTTPS_KEY=./certs/server.key
HTTPS_CERT=./certs/server.cert

# ---------- 多实例标识（可选，一般不设） ----------
# 用于桌宠/WebSocket 场景区分实例；留空自动生成
# INSTANCE_ID=starguard-01
