# ============================================================
# 生产部署环境变量（公网 HTTPS 版）
# 复制为 deploy/.env.production.local 后填写真实值，再用：
#   docker compose --env-file deploy/.env.production.local up -d --build
# ============================================================

# ---- 域名与证书 ----
# 你的真实域名，必须已做 DNS A 记录指向本服务器公网 IP
DOMAIN=starguard.example.com
# Let's Encrypt 注册邮箱（证书到期提醒、重要）
EMAIL=admin@example.com

# ---- 数据库 ----
DB_USER=spchild
# ⚠️ 生产务必改为强随机密码（建议 24 位以上，含大小写+数字+符号）
DB_PASSWORD=CHANGE_ME_strong_db_password_24+
DB_NAME=spchild

# ---- Redis（限流 / Session / Socket.IO 适配）----
# ⚠️ 同上，强随机密码
REDIS_PASSWORD=CHANGE_ME_strong_redis_password_24+

# ---- 后端（会被 compose environment 覆盖，这里仅作本地参考）----
PORT=3000
APP_BASE_URL=https://starguard.example.com
# 云部署由 Nginx 终止 TLS，后端只跑内网 HTTP
ENABLE_HTTPS=false
